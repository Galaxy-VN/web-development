@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="h3 fw-bold mb-1">Danh sách đơn hàng</h2>
        <p class="text-muted mb-0">Theo dõi trạng thái và chi tiết giao hàng theo từng đơn.</p>
    </div>
</div>

<div class="wb-section-card p-3">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table wb-data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Địa chỉ giao hàng</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold">#@order.Id</td>
                            <td>@order.OrderDate</td>
                            <td class="fw-semibold">@order.TotalPrice.ToString("C")</td>
                            <td>@order.ShippingAddress</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info mb-0">Chưa có đơn hàng nào.</div>
    }
</div>
