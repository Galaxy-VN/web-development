@model WebBanHang.Models.Category
@{
	ViewData["Title"] = "Xóa danh mục";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h1 class="h5 mb-0">Xác nhận xóa danh mục</h1>
            </div>
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                <p class="mt-3 mb-1">Bạn có chắc chắn muốn xóa danh mục:</p>
                <p class="fw-bold fs-5">@Model.Name</p>
                <p class="text-muted small">Thao tác này không thể hoàn tác.</p>
                <form asp-action="Delete" class="d-flex justify-content-center gap-2 mt-3">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Xóa danh mục</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </form>
            </div>
        </div>
    </div>
</div>
