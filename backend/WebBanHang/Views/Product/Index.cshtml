@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Store";
}

<div class="mt-2">
    <div class="wb-page-hero mb-4">
        <h1 class="h3 fw-bold mb-2">Sản phẩm nổi bật</h1>
        <p class="mb-0">Chọn nhanh sản phẩm phù hợp và thêm vào giỏ chỉ với một chạm.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <a asp-action="Display" asp-route-id="@product.Id" class="text-decoration-none text-dark">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex justify-content-center align-items-center" style="height: 200px;">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-semibold text-truncate" title="@product.Name">@product.Name</h5>
                            <p class="card-text text-success fw-bold fs-5 mb-2">@product.Price.ToString("C")</p>
                            <p class="card-text text-muted small text-truncate">@product.Description</p>
                        </div>
                    </a>
                    <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                        <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-outline-primary w-100 fw-semibold">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h4 class="text-muted">Chưa có sản phẩm.</h4>
            <p>Vui lòng quay lại sau để xem cập nhật mới.</p>
        </div>
    }
</div>