@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-7">
        <div class="wb-section-card p-5 text-center">
            <div class="mb-3 text-success" style="font-size: 3rem;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h1 class="h2 fw-bold">Thanh toán thành công</h1>
            <p class="text-muted mt-3 mb-4">Cảm ơn bạn đã mua sắm tại WebBanHang. Đơn hàng của bạn đang được xử lý và sẽ sớm được giao.</p>

            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn wb-btn-primary text-white px-4">Về trang chủ</a>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4">Tiếp tục mua sắm</a>
            </div>
        </div>
    </div>
</div>
