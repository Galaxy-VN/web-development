# Ignore build outputs
bin/
obj/
out/

# User options
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio
.vs/

# Entity Framework Migrations snapshots và DB
**/Migrations/*Snapshot.cs
*.db
*.ldb

# App settings local/private
appsettings.Development.json
secrets.json

# Logs
*.log

# Thêm token tạm/mỗi môi trường nếu cần
.env

# Optional: avoid tracking Migrations nếu bạn muốn
# nhưng lưu ý Migrations thường cần dùng cho team và deploy. 
# Nếu muốn loại bỏ Migrations đã tracked cũ, chạy:
# git rm -r --cached WebBanHang/Migrations
# git commit -m "Remove tracked migrations"
